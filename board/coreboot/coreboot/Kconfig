if VENDOR_COREBOOT

config SYS_BOARD
	default "coreboot"

config SYS_VENDOR
	default "coreboot"

config SYS_SOC
	default "coreboot"

config TEXT_BASE
	default 0x01110000

config BOARD_SPECIFIC_OPTIONS # dummy
	def_bool y
	select BOARD_EARLY_INIT_R

config SYS_CAR_ADDR
	hex "Board specific Cache-As-RAM (CAR) address"
	default 0x01920000
	help
	  This option specifies the board specific Cache-As-RAM (CAR) address.

config SYS_CAR_SIZE
	hex "Board specific Cache-As-RAM (CAR) size"
	default 0x4000
	help
	  This option specifies the board specific Cache-As-RAM (CAR) size.

config COREBOOT_CAPSULE_DFU_ALT_INFO
	string "DFU description of the flash region a capsule updates"
	depends on EFI_HAVE_CAPSULE_SUPPORT
	default "sf 0:0=COREBOOT-RECOVERY-A raw 0x40000 0x770000"
	help
	  The dfu_alt_info string for the one image that UEFI capsules
	  update. The default is the RECOVERY_A region of the AMD A/B
	  flash layout (coreboot's board_rave2_ab.fmd).

endif  # CONFIG_VENDOR_COREBOOT
